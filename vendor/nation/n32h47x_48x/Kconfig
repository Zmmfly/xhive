choice
    prompt "Select Nation N32H47x/48x Series"
    default NATION_N32H474
    help
      Select the specific Nation N32H47x/48x series microcontroller to use.
      You can only select one option.

    config NATION_N32H473
        bool "Nation N32H473 Series"

    config NATION_N32H474
        bool "Nation N32H474 Series"

    config NATION_N32H475
        bool "Nation N32H475 Series"
    
    config NATION_N32H481
        bool "Nation N32H481 Series"
        
    config NATION_N32H482
        bool "Nation N32H482 Series"
    
    config NATION_N32H487
        bool "Nation N32H487 Series"
    
    config NATION_N32H488
        bool "Nation N32H488 Series"

endchoice

config NATION_N32H47X_48X_USE_USBFS
    bool "Enable USBFS Driver"
    default y
    help
      Enable the USBFS driver for the Nation N32H47x/48x series microcontrollers.
      This option is useful if your application requires USB functionality.

config NATION_N32H47X_48X_USE_USBHS
    bool "Enable USBHS Driver"
    default n
    help
      Enable the USBHS driver for the Nation N32H47x/48x series microcontrollers.
      This option is useful if your application requires high-speed USB functionality.

config NATION_N32H47X_48X_USB_DEVICE
    bool "Enable USB Device Mode"
    default y
    depends on NATION_N32H47X_48X_USE_USBFS || NATION_N32H47X_48X_USE_USBHS
    help
      Enable USB device mode for the Nation N32H47x/48x series microcontrollers.
      This option is useful if your application needs to function as a USB device.

config NATION_N32H47X_48X_USB_HOST
    bool "Enable USB Host Mode"
    default n
    depends on NATION_N32H47X_48X_USE_USBFS || NATION_N32H47X_48X_USE_USBHS
    help
      Enable USB host mode for the Nation N32H47x/48x series microcontrollers.
      This option is useful if your application needs to function as a USB host.

config NATION_N32H47X_48X_EXTERNAL_INC_DIR
    string "External Include Directory"
    default ""
    depends on NATION_N32H47X_48X_USE_USBFS || NATION_N32H47X_48X_USE_USBHS
    help
      Specify an external usbfs/usbhs config and bsp include directory.
      This option must be set when using USBFS/USBHS in your application.
      The path refers to project directory.

config NATION_N32H47X_48X_ALGO
    bool "Enable Cryptographic Algorithms"
    default n
    help
      Enable hardware-accelerated cryptographic algorithms for the Nation N32H47x/48x series microcontrollers.
      This option is useful for applications that require secure data handling and encryption.

