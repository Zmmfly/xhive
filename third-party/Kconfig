menu "Third-party configurations"

choice
    prompt "Choice RTOS"
    default THIRD_RTOS_NONE

config THIRD_RTOS_NONE
    bool "No RTOS"
    help
      Select this option if you do not want to use any RTOS.

config THIRD_RTOS_FREERTOS
    bool "FreeRTOS"
    help
      Select this option to use FreeRTOS as the RTOS for your embedded application.

config THIRD_RTOS_RTTHREAD_STD
    bool "RT-Thread"
    help
      Select this option to use RT-Thread as the RTOS for your embedded application.

config THIRD_RTOS_RTTNANO
    bool "RT-Thread Nano"
    help
      Select this option to use RT-Thread Nano as the RTOS for your embedded application.

endchoice

if THIRD_RTOS_FREERTOS
menu "FreeRTOS configurations"
    orsource "freertos/Kconfig"
endmenu
endif

if THIRD_RTOS_RTTHREAD_STD
menu "RT-Thread configurations"
    orsource "rt-thread/Kconfig"
endmenu
endif

if THIRD_RTOS_RTTNANO
menu "RT-Thread Nano configurations"
    choice RTTNANO_RISCV_PORT
        prompt "RISC-V port implementation"
        depends on CPU_RISCV
        default RTTNANO_RISCV_PORT_STANDARD

        config RTTNANO_RISCV_PORT_STANDARD
            bool "Built-in RISC-V port"
            help
                Use Nano's standard RISC-V CSR context implementation and
                SDK board support. The application must configure its tick
                interrupt and any board-specific interrupt entry.

        config RTTNANO_RISCV_PORT_CUSTOM
            bool "Application-provided RISC-V port"
            help
                Do not compile Nano's built-in libcpu or port sources.
                Add your CPU context, interrupt, tick and board initialization
                sources to the application target. Nano kernel, components
                and configuration header generation remain managed by xhive.
    endchoice

    orsource "rttnano/Kconfig"
endmenu
endif

menuconfig THIRD_SEGGER_RTT
    bool "Enable SEGGER RTT"
    default y
    help
        Enable this option to include SEGGER RTT (Real-Time Transfer) support in your embedded application for debugging and logging purposes.

    if THIRD_SEGGER_RTT
        orsource "SEGGER_RTT/Kconfig"
    endif

endmenu
