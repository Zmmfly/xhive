    default n
    if MBEDTLS_USE_USER_CONFIG_FILE
        config MBEDTLS_USER_CONFIG_FILE
            string "Path to user configuration file for mbed TLS"
            default ""
            help
                The relative path referenced from the root of the project.
    endif
