menu "Libraries Configuration"

config LIBS_ADD_CJSON
    bool "Add cJSON Library"
    default n
    help
        Enable the cJSON library for JSON parsing and serialization.

menuconfig LIBS_ADD_HEATSHRINK
    bool "Add HeatsShrink Library"
    default n
    help
        Add the HeatsShrink library for data compression.

    if LIBS_ADD_HEATSHRINK
        rsource "heatshrink/Kconfig"
    endif

menuconfig LIBS_ADD_MICRO_ECC
    bool "Add micro-ecc Library"
    default n
    help
        Add the micro-ecc library for ECC (Elliptic Curve Cryptography) operations.

    if LIBS_ADD_MICRO_ECC
        rsource "micro-ecc/Kconfig"
    endif

menuconfig LIBS_ADD_DIVSUFSORT
    bool "Add DivSufSort Library"
    default n
    help
        Add the DivSufSort library for suffix array construction.

    if LIBS_ADD_DIVSUFSORT
        rsource "divsufsort/Kconfig"
    endif

menuconfig LIBS_ADD_MBEDTLS
    bool "Add mbedTLS Library"
    default n
    help
        Add the mbedTLS library for SSL/TLS and cryptographic functions.

    if LIBS_ADD_MBEDTLS
        rsource "mbedtls/Kconfig"
    endif

config LIBS_ADD_XXHASH
    bool "Add xxHash Library"
    default n
    help
        Add the xxHash library for fast hashing functions.

config LIBS_ADD_SHA256
    bool "Add SHA256 Library"
    default n
    help
        Add the SHA256 library for SHA-256 hashing functions.

config LIBS_ADD_BASE64
    bool "Add Base64 Library"
    default n
    help
        Add the Base64 library for Base64 encoding and decoding.

config LIBS_ADD_BITMAP
    bool "Add Bitmap Library"
    default n
    help
        Add the Bitmap library for bitmap manipulation.

config LIBS_ADD_EZCTRL
    bool "Add ezctrl Control Library"
    default n
    help
        Add the ezctrl control library (PID controller and other control
        primitives).

config LIBS_ADD_LINEARS
    bool "Add linears Matrix Library"
    default n
    help
        Add allocation-free matrix operations in f32, f64, q15, and q31.
        Fixed-point matrices use explicit binary block exponents.

config LIBS_ADD_FILTERS
    bool "Add filters Signal Processing Library"
    default n
    select LIBS_ADD_LINEARS
    help
        Add allocation-free streaming filters and Kalman estimation in
        f32, f64, q15, and q31, using the linears numeric kernel.

config LIBS_ADD_FIELDCTRL
    bool "Add fieldctrl Motor Control Library"
    default n
    select LIBS_ADD_LINEARS
    select LIBS_ADD_FILTERS
    help
        Add allocation-free VVVF, FOC/SMO, and DTC software algorithms in
        f32, f64, q15, and q31. Hardware protection is application-owned.

config LIBS_ADD_LLHTTP
    bool "Add llhttp Library"
    default n
    help
        Add the llhttp library for HTTP parsing.

endmenu # Libraries Configuration
